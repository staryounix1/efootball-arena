{
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm install --frozen-lockfile && cd artifacts/efootball-arena && pnpm run build",
  "outputDirectory": "artifacts/efootball-arena/dist/public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}